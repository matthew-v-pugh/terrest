# Copy to .env and fill in from https://discord.com/developers/applications
# (your app > OAuth2). The VITE_ prefix exposes the client ID to the browser
# bundle; the secret stays on the server.
VITE_DISCORD_CLIENT_ID=your_application_id
DISCORD_CLIENT_SECRET=your_client_secret
# Bot token (your app > Bot > Reset Token). The server uses it to check that each
# player is really connected to the activity instance they join. Keep it secret.
DISCORD_BOT_TOKEN=your_bot_token

# Allow plain browser tabs to join without Discord (for local testing).
# Set to false in production.
DEV_LOGIN=true
