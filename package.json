{
  "name": "terrest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A tabletop role-playing Discord Activity: storytellers set the rules, players build characters, everyone rolls at the table.",
  "scripts": {
    "dev": "concurrently -k -n worker,client -c magenta,cyan \"npm:dev:worker\" \"npm:dev:client\"",
    "dev:worker": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && wrangler dev --port 8787",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite build && wrangler dev --port 8787",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.5",
    "wrangler": "^4.162.0"
  }
}
